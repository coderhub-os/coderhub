<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="color-scheme" content="light dark">
<title>{{TITLE}}</title>
{{MODE_SCRIPT}}
<link rel="icon" href="{{FAVICON}}" type="image/svg+xml">
<style>{{CSS}}</style>
